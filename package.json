{
  "name": "@comput/pi-telegram",
  "version": "0.6.7",
  "description": "Your Pi session, wherever you are. Send requests, share screenshots and get replies and files through Telegram—without losing your project context.",
  "license": "MIT",
  "author": "Martin Bundgaard",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "telegram",
    "coding-agent"
  ],
  "homepage": "https://github.com/mbundgaard/pi-telegram#readme",
  "bugs": {
    "url": "https://github.com/mbundgaard/pi-telegram/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbundgaard/pi-telegram.git"
  },
  "files": [
    "src/**/*.ts",
    "skills/pi-telegram/**/*.md",
    "README.md",
    "docs/user-guide.md",
    "docs/agent-tools.md",
    "docs/development-status.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/pi-telegram"
    ]
  },
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2"
    }
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.5"
  }
}
